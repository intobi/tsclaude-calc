<Project>
  <!--
    How a project gets Calculator.Contracts:
      * default: from source (ProjectReference), for fast development inside this solution;
      * -p:UseContractsPackage=true: from the published NuGet package, the way other teams consume it.
    Publish the package with:  dotnet pack Calculator.Contracts -c Release -o artifacts/packages
  -->
  <ItemGroup Condition="'$(UseContractsPackage)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Calculator.Contracts/Calculator.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseContractsPackage)' == 'true'">
    <PackageReference Include="Calculator.Contracts" Version="$(ContractsVersion)" />
  </ItemGroup>
</Project>
